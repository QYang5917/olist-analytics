# Snowflake connection settings.
# Copy this file to .env and fill in your own values. .env is git-ignored;
# never commit it. No password goes in here: the scripts sign in with a key file.

# Snowsight > your name (bottom left) > Account > View account details
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME

# The username you chose when you activated the account
SNOWFLAKE_USER=your_username

# Private key made by snowflake/setup_key.sh. It lives outside this repo.
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/keys/olist_rsa_key.p8

# Created by snowflake/00_setup.sql
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=OLIST_WH
SNOWFLAKE_DATABASE=OLIST
SNOWFLAKE_SCHEMA=RAW
